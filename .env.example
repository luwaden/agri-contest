# ═══ Application window (ISO 8601 with timezone; Nigeria = +01:00) ═══
APPLICATION_OPEN_DATE=2026-10-08T00:00:00+01:00
APPLICATION_CLOSE_DATE=2026-10-16T23:59:59+01:00

# ═══ Public site ═══
NEXT_PUBLIC_SITE_URL=http://localhost:3000        # your real https URL in production (sitemap, social previews)

# ═══ Data store: "appsscript" (script inside the sheet) | "sheets" (service account) | "local" (development only; blocked in production) ═══
DATA_BACKEND=local
# appsscript: see docs/GO_LIVE_GOOGLE_SHEETS.md, Option A
APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=
# sheets: see Option B
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=                                # keep the \n sequences, wrap in double quotes

# ═══ Optional Google Apps Script mirror (see docs/GOOGLE_SCRIPT.md). Off when empty ═══
GOOGLE_SCRIPT_URL=
GOOGLE_SCRIPT_SECRET=

# ═══ Staff sign-in ═══
SESSION_SECRET=                                    # 32+ random characters
# npm run hash-password -- "password". In .env files escape each $ as \$ (hosting dashboards take it as-is). Roles: ADMIN | COORDINATOR | JUDGE
ADMIN_USERS_JSON=[{"email":"admin@example.org","name":"Programme Admin","role":"ADMIN","passwordHash":"<bcrypt hash>"}]

# ═══ Cloudinary (file uploads). Uploads show a friendly message until these are set ═══
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_DELIVERY=authenticated                  # private files + signed links (recommended) | upload = public URLs
CLOUDINARY_ROOT_FOLDER=programme
UPLOAD_MAX_MB=8

# ═══ Redis (Upstash). Recommended on Vercel; see docs/UPSTASH.md. Site works without it ═══
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# (Vercel's Upstash integration may call them KV_REST_API_URL / KV_REST_API_TOKEN: also accepted)

# ═══ Diagnostics ═══
HEALTH_CHECK_TOKEN=                                # optional: if set, /api/health?check=store needs &token=<this>
NEXT_PUBLIC_ASSISTANT_PUBLIC=false                 # false = Ask button for signed-in staff only (default); true = everyone
FINALE_DATE_LABEL=                                 # leave empty: the site shows Thursday 29 October 2026

# ═══ AI assistant (inactive until configured). One provider at a time ═══
AI_PROVIDER=none                                   # none | openai | claude
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
AI_ALLOW_TEXT_EXCERPTS=false                       # true = may send short anonymised excerpts of applicants' own words

# ═══ Hosting (Render, etc.) ═══
TRUST_PROXY=false                                  # true behind a proxy that sets x-forwarded-for (Render does)
CORS_ALLOWED_ORIGINS=                              # only if the frontend is hosted on a different domain from the API

# ═══ Demo data (development only; ignored in production) ═══
NEXT_PUBLIC_DEMO_MODE=false
