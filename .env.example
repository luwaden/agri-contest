# ═══ Application window (ISO 8601 with timezone; Nigeria = +01:00) ═══
APPLICATION_OPEN_DATE=2026-10-08T00:00:00+01:00
APPLICATION_CLOSE_DATE=2026-10-16T23:59:59+01:00
LEVEL2_OPEN_TO_ALL=false                           # true = every Level 1 applicant may apply to Level 2 (code + email); false = invite list only
LEVEL2_CLOSE_DATE=                                 # optional: Level 2 form closes at this time, e.g. 2026-11-05T23:59:59+01:00 (empty = open for invited applicants)

# ═══ Public site ═══
NEXT_PUBLIC_SITE_URL=http://localhost:3000        # your real https URL in production (sitemap, social previews)

# ═══ Data store: "appsscript" (script inside the sheet) | "sheets" (service account) | "local" (development only; blocked in production) ═══
DATA_BACKEND=local
# appsscript: see docs/GO_LIVE_GOOGLE_SHEETS.md, Option A
APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=
# sheets: see Option B
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=                                # keep the \n sequences, wrap in double quotes

# ═══ Optional Google Apps Script mirror (see docs/GOOGLE_SCRIPT.md). Off when empty ═══
GOOGLE_SCRIPT_URL=
GOOGLE_SCRIPT_SECRET=

# ═══ Staff sign-in ═══
SESSION_SECRET=                                    # 32+ random characters
# npm run hash-password -- "password". In .env files escape each $ as \$ (hosting dashboards take it as-is). Roles: ADMIN | COORDINATOR | JUDGE
ADMIN_USERS_JSON=[{"email":"admin@example.org","name":"Programme Admin","role":"ADMIN","passwordHash":"<bcrypt hash>"}]

# ═══ Cloudinary (file uploads). Uploads show a friendly message until these are set ═══
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_DELIVERY=authenticated                  # private files + signed links (recommended) | upload = public URLs
CLOUDINARY_ROOT_FOLDER=programme
UPLOAD_MAX_MB=8
# Level 2 files: cloudinary | local. Empty = Cloudinary when set up above, otherwise this server's disk (FILE_STORE_DIR).
# "local" needs a disk that survives restarts/redeploys (your own PC or a VPS); staff open these files from the Level 2 CSV links.
UPLOAD_STORAGE=
FILE_STORE_DIR=.data/files                          # also holds Messages attachments; git-ignored (.data)

# ═══ Redis (Upstash). Recommended on Vercel; see docs/UPSTASH.md. Site works without it ═══
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# (Vercel's Upstash integration may call them KV_REST_API_URL / KV_REST_API_TOKEN: also accepted)

# ═══ Confirmation email to APPLICANTS only (see docs/EMAIL.md). Off when empty: the site works as before ═══
# Option 1, Gmail (no domain needed, about 500 emails a day). Needs 2-Step Verification and a 16-letter App Password:
GMAIL_USER=                                        # e.g. youthagriinnovate@gmail.com
GMAIL_APP_PASSWORD=
# Option 2, Resend (needs a domain you own; free plan = 100 emails a day). Used instead of Gmail when both are set:
RESEND_API_KEY=
EMAIL_FROM=                                        # e.g. Youth Agri-Innovation Contest <apply@yourdomain.org>
# Both options:
EMAIL_REPLY_TO=                                    # where replies go; empty = the contact address on the site
EMAIL_DAILY_LIMIT=                                 # Admin → Messages: most emails per day (default 450 with Gmail, 5000 with Resend)
EMAIL_ATTACHMENT_MAX_MB=10                         # total size of files attached to one message (max 20; Gmail refuses over 25 MB)

# ═══ Diagnostics ═══
HEALTH_CHECK_TOKEN=                                # optional: if set, /api/health?check=store needs &token=<this>
NEXT_PUBLIC_ASSISTANT_PUBLIC=false                 # false = Ask button for signed-in staff only (default); true = everyone
FINALE_DATE_LABEL=                                 # leave empty: the site shows Thursday 29 October 2026

# ═══ AI assistant (inactive until configured). One provider at a time ═══
AI_PROVIDER=none                                   # none | openai | claude
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_REASONING_EFFORT=low                         # OpenAI reasoning models only: none | minimal | low | medium | high (less = faster, cheaper, fewer empty replies; accepted values depend on the model)
AI_MAX_OUTPUT_TOKENS=                              # optional: bigger budget per AI reply (thinking + answer), e.g. 8000
AI_ALLOW_TEXT_EXCERPTS=false                       # true = may send short anonymised excerpts of applicants' own words
AI_FULL_DATA_ACCESS=false                          # AI data desk (admins): true = the AI may also READ phone, email, address, date of birth, disability type. It can never change data either way.

# ═══ Hosting (Render, etc.) ═══
TRUST_PROXY=false                                  # true behind a proxy that sets x-forwarded-for (Render does)
CORS_ALLOWED_ORIGINS=                              # only if the frontend is hosted on a different domain from the API

# ═══ Demo data (development only; ignored in production) ═══
NEXT_PUBLIC_DEMO_MODE=false
