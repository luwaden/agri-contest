# ── Application window (ISO 8601 with timezone; Nigeria = +01:00) ──
APPLICATION_OPEN_DATE=2026-09-302T00:00:00+01:00
APPLICATION_CLOSE_DATE=2026-10-16T23:59:59+01:00

# ── Data backend: "sheets" or "local" (local = .data/ JSON file, development only) ──
DATA_BACKEND=local
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key from the service-account JSON, keeping the \n sequences, inside double quotes
GOOGLE_PRIVATE_KEY=

# ── Staff sign-in ──
# 32+ random characters. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Create hashes with: npm run hash-password -- "the password"
# Single line JSON. Roles: ADMIN | COORDINATOR | JUDGE
ADMIN_USERS_JSON=[{"email":"admin@example.org","name":"Programme Admin","role":"ADMIN","passwordHash":"<bcrypt hash>"}]

# ── Demo mode (development only; ignored when NODE_ENV=production) ──
NEXT_PUBLIC_DEMO_MODE=false
